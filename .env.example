# server
NODE_ENV=development
PORT=5000
# MongoDB Atlas free-tier cluster connection string (see cloud.mongodb.com).
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=<cluster-name>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/gsmotors?retryWrites=true&w=majority

# Admin dashboard auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@gsmotors.com.np
# bcrypt hash of the admin password — generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# IMPORTANT: docker-compose interpolates $VAR in .env values, and bcrypt hashes
# contain literal $ characters — double every $ as $$ in THIS file (root .env),
# but NOT in server/.env, which dotenv reads directly with no interpolation.
ADMIN_PASSWORD_HASH=

CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=5

# client
# Host-side port for the server is 5050 (see docker-compose.yml — macOS's
# AirPlay Receiver occupies port 5000 by default). The server's internal
# PORT above is unaffected.
VITE_API_URL=http://localhost:5050/api
